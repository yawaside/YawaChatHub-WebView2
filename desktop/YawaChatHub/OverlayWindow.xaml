<Window x:Class="YawaChatHub.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YawaChatHub — оверлей"
        Width="420" Height="560"
        MinWidth="280" MinHeight="220"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="1">
    <!-- WindowChrome для оверлея: CaptionHeight="32" позволяет таскать окно
         за шапку, ResizeBorderThickness даёт возможность менять размер. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#00000000" />
    </Grid>
</Window>
