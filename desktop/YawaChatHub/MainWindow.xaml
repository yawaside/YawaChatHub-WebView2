<Window x:Class="YawaChatHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YawaChatHub"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0b0e17"
        KeyDown="Window_KeyDown">
    <!-- Убираем системную non-client рамку безрамочного окна (белая полоса
         сверху). ResizeBorderThickness сохраняет возможность изменения
         размера окна за краями. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    <Grid Background="#0b0e17">
        <!-- Не показываем WebView2 до успешной навигации: белая поверхность
             Chromium не успевает мелькнуть верхней полосой. -->
        <wv2:WebView2 x:Name="WebView"
                     Visibility="Collapsed"
                     DefaultBackgroundColor="#FF0B0E17"
                     Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Нативный экран виден до успешной навигации WebView2. Поэтому при
             отсутствии Runtime/HTML вместо пустого зависшего окна есть диагноз. -->
        <Border x:Name="StatusPanel"
                Background="#0b0e17"
                BorderBrush="#292f42"
                BorderThickness="1"
                Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#101522"
                        BorderBrush="#292f42" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="StatusTitle_MouseLeftButtonDown">
                    <Grid Margin="14,0,8,0">
                        <TextBlock Text="YawaChatHub" Foreground="#eef1f8"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Width="34" Height="28"
                                Content="✕" Foreground="#fb7185" Background="Transparent"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                Click="StatusClose_Click" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Width="620" MaxWidth="620"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16"
                            Background="#7568e8" HorizontalAlignment="Center">
                        <TextBlock Text="Y" Foreground="White" FontWeight="Bold"
                                   FontSize="24" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StatusTitle" Text="Запуск интерфейса…"
                               Foreground="#eef1f8" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,8" />
                    <TextBlock x:Name="StatusText"
                               Text="Подготовка встроенных файлов и Microsoft Edge WebView2"
                               Foreground="#929bb0" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="20" />
                    <StackPanel x:Name="ErrorActions" Visibility="Collapsed"
                                Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <Button Content="Повторить" Padding="18,8" Margin="0,0,10,0"
                                Foreground="White" Background="#7568e8"
                                BorderBrush="#8b7bff" Cursor="Hand"
                                Click="StatusRetry_Click" />
                        <Button Content="Закрыть приложение" Padding="18,8"
                                Foreground="#eef1f8" Background="#171c2c"
                                BorderBrush="#343b51" Cursor="Hand"
                                Click="StatusClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
