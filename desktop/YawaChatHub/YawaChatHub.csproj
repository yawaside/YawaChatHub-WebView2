<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YawaChatHub</RootNamespace>
    <AssemblyName>YawaChatHub</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>4.0.0</Version>
    <ApplicationIcon>..\build\icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <!-- Фронтенд ВСТРАИВАЕТСЯ в exe (а не копируется папкой рядом), чтобы
       portable-сборка из одного файла работала автономно. При запуске
       WebAssets.cs распаковывает HTML в %LOCALAPPDATA%\YawaChatHub\web. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\index.html"
                      LogicalName="YawaChatHub.dist.index.html"
                      Condition="Exists('..\..\dist\index.html')" />
    <EmbeddedResource Include="..\widget\index.html"
                      LogicalName="YawaChatHub.widget.index.html"
                      Condition="Exists('..\widget\index.html')" />
  </ItemGroup>

</Project>
